# ─── CẤU HÌNH ỨNG DỤNG ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Data Capture - Ứng dụng số hóa
NEXT_PUBLIC_APP_URL=https://datacapture.expertai.io.vn

# ─── CHẾ ĐỘ DEMO (SQLite local, không cần Supabase) ────────────────────────
# Đặt DEMO_MODE=true để dùng SQLite thay vì PostgreSQL
DEMO_MODE=true

# ─── AI – Giả lập (không gọi Gemini thật) ───────────────────────────────────
# Đặt MOCK_AI=true để test mà không cần API key Gemini
MOCK_AI=true

# ─── BẢO MẬT SESSION (THAY ĐỔI TRƯỚC KHI DEPLOY) ───────────────────────────
# Tạo secret bằng: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_BASE64_32

# ─── GEMINI AI (chỉ cần khi MOCK_AI=false) ───────────────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── NGƯỠNG ĐỘ TIN CẬY AI ────────────────────────────────────────────────────
AI_CONFIDENCE_AUTO_CONFIRM=0.92
AI_CONFIDENCE_MANUAL_REVIEW=0.75

# ─── UPLOAD ──────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
SIGNED_URL_EXPIRES_SECONDS=3600

# ─── LOG ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
