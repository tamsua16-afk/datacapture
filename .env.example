NEXT_PUBLIC_APP_NAME=Xưởng Data Capture
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (bỏ trống để dùng Demo Mode) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini AI ────────────────────────────────────────────────────────────────────
# Kiểm tra model mới nhất tại: https://ai.google.dev/gemini-api/docs/models
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── Upload ───────────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
SIGNED_URL_EXPIRES_SECONDS=3600

# ── AI Confidence Thresholds ─────────────────────────────────────────────────────
# Từ 0.92 trở lên: tự xác nhận nhanh
# Từ 0.75 đến <0.92: kế toán kiểm tra
# Dưới 0.75: yêu cầu kiểm tra kỹ
AI_CONFIDENCE_AUTO_CONFIRM=0.92
AI_CONFIDENCE_MANUAL_REVIEW=0.75

# ── Demo / Development Mode ───────────────────────────────────────────────────────
# DEMO_MODE=true  → dùng SQLite local, không cần Supabase
# MOCK_AI=true    → giả lập kết quả AI, không gọi Gemini
DEMO_MODE=true
MOCK_AI=true

# ── Logging ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Session Secret (tạo bằng: openssl rand -base64 32) ────────────────────────
SESSION_SECRET=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND
